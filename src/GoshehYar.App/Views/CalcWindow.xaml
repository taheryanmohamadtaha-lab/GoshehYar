<Window x:Class="GoshehYar.App.Views.CalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_calc]}"
        Width="460" Height="640" MinWidth="400" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <Window.Resources>
        <Style x:Key="Style.CalcKey" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Style.Muted}" Margin="0,8,0,0" />
        <TabControl>

            <TabItem Header="{Binding [calc_tab_calc]}">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox x:Name="ExprBox" Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" FontSize="22"
                                 FlowDirection="LeftToRight" KeyDown="ExprBox_KeyDown" Padding="6" />
                        <TextBlock Text="{Binding ResultText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   FlowDirection="LeftToRight" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ErrorText, Mode=OneWay}" Foreground="OrangeRed" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding [calc_clear_history]}" Command="{Binding ClearHistoryCommand}" Margin="3" />
                            <TextBlock Text="{Binding [calc_history]}" Style="{StaticResource Style.Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory, Mode=OneWay}" DisplayMemberPath="Text"
                                 Height="90" FlowDirection="LeftToRight" />
                    </StackPanel>
                    <StackPanel>
                        <UniformGrid Columns="4" FlowDirection="LeftToRight" Margin="0,8,0,0">
                            <Button Content="C" CommandParameter="C" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="⌫" CommandParameter="BACK" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="{Binding [calc_copy_result]}" Command="{Binding CopyResultCommand}" Style="{StaticResource Style.CalcKey}" FontSize="12" />
                            <Button Content="=" CommandParameter="EQ" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="7" CommandParameter="7" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="8" CommandParameter="8" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="9" CommandParameter="9" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="÷" CommandParameter="/" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="4" CommandParameter="4" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="5" CommandParameter="5" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="6" CommandParameter="6" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="×" CommandParameter="*" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="1" CommandParameter="1" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="2" CommandParameter="2" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="3" CommandParameter="3" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="−" CommandParameter="-" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="0" CommandParameter="0" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="." CommandParameter="." Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="(" CommandParameter="(" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="+" CommandParameter="+" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content=")" CommandParameter=")" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="%" CommandParameter="%" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="√" CommandParameter="SQRT" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                            <Button Content="±" CommandParameter="NEG" Command="{Binding InputCommand}" Style="{StaticResource Style.CalcKey}" />
                        </UniformGrid>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding [calc_tab_percent]}">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding [calc_pct_a_title]}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                        <TextBox Width="80" Text="{Binding PctAPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" % × " VerticalAlignment="Center" />
                        <TextBox Width="100" Text="{Binding PctANumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" = " VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PctAResult, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding [calc_pct_b_title]}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                        <TextBox Width="100" Text="{Binding PctBPart, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" / " VerticalAlignment="Center" />
                        <TextBox Width="100" Text="{Binding PctBWhole, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" = " VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PctBResult, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding [calc_pct_c_title]}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                        <TextBox Width="100" Text="{Binding PctCValue, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" ± " VerticalAlignment="Center" />
                        <TextBox Width="80" Text="{Binding PctCPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text=" %" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0">
                        <Run Text="{Binding [calc_pct_increase], Mode=OneWay}" /> <Run Text="{Binding PctCIncrease, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock>
                        <Run Text="{Binding [calc_pct_decrease], Mode=OneWay}" /> <Run Text="{Binding PctCDecrease, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding [calc_tab_units]}">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding [calc_unit_category]}" Style="{StaticResource Style.Muted}" />
                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Category}" />
                    <TextBlock Text="{Binding [calc_unit_value]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding UnitValue, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding [calc_unit_from]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding FromUnit}" />
                    <Button Content="{Binding [calc_unit_swap]}" Command="{Binding SwapUnitsCommand}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding [calc_unit_to]}" Style="{StaticResource Style.Muted}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ToUnit}" />
                    <TextBlock Text="{Binding UnitResult, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,0" FlowDirection="LeftToRight" />
                    <Button Content="{Binding [calc_unit_copy]}" Command="{Binding CopyUnitResultCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding [calc_data_note]}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDataNote}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding [calc_tab_password]}">
                <StackPanel Margin="12">
                    <TextBox Text="{Binding Password, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="16" FlowDirection="LeftToRight" Padding="6" />
                    <TextBlock Text="{Binding [calc_pw_none]}" Foreground="OrangeRed" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PasswordOptionsMissing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding [calc_pw_generate]}" Command="{Binding GeneratePasswordCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding [calc_pw_copy]}" Command="{Binding CopyPasswordCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0">
                        <Run Text="{Binding [calc_pw_length], Mode=OneWay}" /> <Run Text="{Binding PasswordLengthText, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <Slider Minimum="8" Maximum="64" Value="{Binding PasswordLength}" TickFrequency="1" IsSnapToTickEnabled="True" FlowDirection="LeftToRight" />
                    <CheckBox Content="{Binding [calc_pw_lower]}" IsChecked="{Binding PwLower}" Margin="0,6,0,0" />
                    <CheckBox Content="{Binding [calc_pw_upper]}" IsChecked="{Binding PwUpper}" Margin="0,4,0,0" />
                    <CheckBox Content="{Binding [calc_pw_digits]}" IsChecked="{Binding PwDigits}" Margin="0,4,0,0" />
                    <CheckBox Content="{Binding [calc_pw_symbols]}" IsChecked="{Binding PwSymbols}" Margin="0,4,0,0" />
                    <CheckBox Content="{Binding [calc_pw_similar]}" IsChecked="{Binding PwSimilar}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding [calc_pw_hint]}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding [calc_tab_date]}">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding [calc_date_today]}" Style="{StaticResource Style.Muted}" />
                    <TextBlock Text="{Binding TodayText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [calc_date_between]}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding [calc_date_from]}" Style="{StaticResource Style.Muted}" Margin="0,6,0,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" />
                    <TextBlock Text="{Binding [calc_date_to]}" Style="{StaticResource Style.Muted}" Margin="0,6,0,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" />
                    <TextBlock Text="{Binding DateResult, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DateTotal, Mode=OneWay}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding [calc_date_hint]}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
