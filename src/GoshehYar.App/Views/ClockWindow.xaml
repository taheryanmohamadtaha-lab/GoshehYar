<Window x:Class="GoshehYar.App.Views.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_clock]}"
        Width="460" Height="720" MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- digital -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                <TextBlock Text="{Binding TimeText}" FontSize="48" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MeridiemText}" FontSize="18" VerticalAlignment="Bottom" Margin="8,0,0,10"
                           Foreground="{DynamicResource Brush.Muted}" />
            </StackPanel>
            <TextBlock Text="{Binding DateText}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0"
                       Foreground="{DynamicResource Brush.Accent}" />

            <!-- analog -->
            <Viewbox Width="220" Height="220" Margin="0,14,0,0" HorizontalAlignment="Center"
                     Visibility="{Binding ShowAnalog, Converter={StaticResource BoolToVisibility}}">
                <Canvas x:Name="Face" Width="200" Height="200" FlowDirection="LeftToRight">
                    <Ellipse Width="196" Height="196" Canvas.Left="2" Canvas.Top="2" StrokeThickness="3"
                             Stroke="{DynamicResource Brush.Border}" Fill="{DynamicResource Brush.Surface}" />
                    <Line X1="100" Y1="100" X2="100" Y2="58" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource Brush.Foreground}">
                        <Line.RenderTransform>
                            <RotateTransform CenterX="100" CenterY="100" Angle="{Binding HourAngle, Mode=OneWay}" />
                        </Line.RenderTransform>
                    </Line>
                    <Line X1="100" Y1="100" X2="100" Y2="34" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource Brush.Foreground}">
                        <Line.RenderTransform>
                            <RotateTransform CenterX="100" CenterY="100" Angle="{Binding MinuteAngle, Mode=OneWay}" />
                        </Line.RenderTransform>
                    </Line>
                    <Line X1="100" Y1="112" X2="100" Y2="26" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource Brush.Accent}"
                          Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVisibility}}">
                        <Line.RenderTransform>
                            <RotateTransform CenterX="100" CenterY="100" Angle="{Binding SecondAngle, Mode=OneWay}" />
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse Width="10" Height="10" Canvas.Left="95" Canvas.Top="95" Fill="{DynamicResource Brush.Accent}" />
                </Canvas>
            </Viewbox>

            <!-- options -->
            <Border Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                <StackPanel>
                    <CheckBox Content="{Binding [clock_24h]}" IsChecked="{Binding Use24Hour}" />
                    <CheckBox Content="{Binding [clock_seconds]}" IsChecked="{Binding ShowSeconds}" Margin="0,6,0,0" />
                    <CheckBox Content="{Binding [clock_analog]}" IsChecked="{Binding ShowAnalog}" Margin="0,6,0,0" />
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding [clock_calendar]}" />
                        <ComboBox Width="170" HorizontalAlignment="Left" ItemsSource="{Binding Calendars}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Calendar}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- world clocks -->
            <TextBlock Text="{Binding [clock_world]}" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBlock Text="{Binding [clock_no_zones]}" Style="{StaticResource Style.Muted}"
                       Visibility="{Binding HasNoZones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding WorldClocks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="28" Height="28" Margin="8,0,0,0"
                                        Style="{StaticResource Style.ToolButton}"
                                        FontFamily="Segoe MDL2 Assets" Content="&#xE711;"
                                        ToolTip="{Binding DataContext[clock_remove], RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="20" FontWeight="SemiBold"
                                           VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Style.Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- add -->
            <TextBlock Text="{Binding [clock_add_zone]}" Margin="0,10,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,4" Content="{Binding [clock_add_zone]}"
                        Command="{Binding AddCommand}" />
                <ComboBox ItemsSource="{Binding ZoneOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding NewZoneId}" FlowDirection="LeftToRight" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Style.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
