<Window x:Class="GoshehYar.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <StackPanel Margin="18">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" />
        <TextBox x:Name="Input" Margin="0,8,0,14" />
        <UniformGrid Rows="1" HorizontalAlignment="Right">
            <Button x:Name="OkButton" IsDefault="True" Margin="0,0,6,0" MinWidth="80" Click="OnOk" />
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="80" />
        </UniformGrid>
    </StackPanel>
</Window>
