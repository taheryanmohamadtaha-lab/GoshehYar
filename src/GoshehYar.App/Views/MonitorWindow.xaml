<Window x:Class="GoshehYar.App.Views.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_monitor]}"
        Width="420" Height="560" MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="{Binding [mon_cpu]}" FontWeight="SemiBold" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Cpu, Mode=OneWay}" Height="10" Margin="0,6,0,2" Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Text="{Binding CpuText, Mode=OneWay}" Style="{StaticResource Style.Muted}" />

            <TextBlock Text="{Binding [mon_ram]}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Ram, Mode=OneWay}" Height="10" Margin="0,6,0,2" Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Text="{Binding RamText, Mode=OneWay}" Style="{StaticResource Style.Muted}" />

            <TextBlock Text="{Binding [mon_network]}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock Margin="0,4,0,0">
                <Run Text="{Binding [mon_down], Mode=OneWay}" /> <Run Text="{Binding DownText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock>
                <Run Text="{Binding [mon_up], Mode=OneWay}" /> <Run Text="{Binding UpText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <TextBlock Text="{Binding [mon_disks]}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding Name}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="8" Margin="0,2,0,2" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding Text, Mode=OneWay}" Style="{StaticResource Style.Muted}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding [mon_battery]}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatteryPercent, Mode=OneWay}" Height="10" Margin="0,6,0,2" Foreground="{DynamicResource Brush.Accent}"
                         Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding BatteryText, Mode=OneWay}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" />

            <TextBlock Text="{Binding [mon_uptime]}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock Text="{Binding UptimeText, Mode=OneWay}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />

            <TextBlock Text="{Binding [mon_hint]}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" Margin="0,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
