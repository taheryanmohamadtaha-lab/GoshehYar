<Window x:Class="GoshehYar.App.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_notes]}"
        Width="900" Height="640" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- left: list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Rows="1">
                <Button Margin="0,0,4,0" Content="{Binding [notes_new]}" Command="{Binding NewNoteCommand}" />
                <Button Margin="4,0,0,0" Content="{Binding [notes_new_checklist]}" Command="{Binding NewChecklistCommand}" />
            </UniformGrid>

            <TextBox Grid.Row="1" Margin="0,8,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Margin="10,8,0,0" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"
                       Text="{Binding [notes_search]}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ComboBox Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding FilterCategory}" />

            <ListBox Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding Notes}" SelectedItem="{Binding Selected}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Border DockPanel.Dock="Left" Width="5" CornerRadius="2" Margin="0,0,8,0" Background="{Binding ColorBrush}" />
                            <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE840;" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4" Margin="0,6,0,0" Text="{Binding CountText}" Style="{StaticResource Style.Muted}" FontSize="12" />
        </Grid>

        <!-- right: editor -->
        <Grid Grid.Column="2">
            <TextBlock Text="{Binding [notes_empty_hint]}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Muted}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowEmptyHint}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" />

                <!-- toolbar: pin, color, category -->
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <ToggleButton DockPanel.Dock="Left" Width="38" Height="32" FontFamily="Segoe MDL2 Assets" Content="&#xE840;"
                                  ToolTip="{Binding [notes_pin]}" IsChecked="{Binding Selected.Pinned}" Margin="0,0,10,0" />
                    <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Colors}" SelectedValuePath="Key" SelectedValue="{Binding Selected.Color}"
                             Background="Transparent" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}" ToolTip="{Binding Label}"
                                        BorderBrush="{DynamicResource Brush.Muted}" BorderThickness="1" Margin="1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ComboBox IsEditable="True" Text="{Binding Selected.Category, UpdateSourceTrigger=LostFocus}"
                              ItemsSource="{Binding CategoryChoices}" ToolTip="{Binding [notes_category]}" />
                </DockPanel>

                <!-- reminder -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                    <TextBlock VerticalAlignment="Center" Text="{Binding [notes_reminder]}" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding Selected.ReminderDate}" Width="140" />
                    <TextBox Width="70" Margin="8,0,0,0" Text="{Binding Selected.ReminderTime, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding Selected.HasReminder}" ToolTip="HH:mm" FlowDirection="LeftToRight" />
                    <Button Margin="8,0,0,0" Padding="9,5" FontFamily="Segoe MDL2 Assets" Content="&#xE711;"
                            ToolTip="{Binding [notes_clear_reminder]}" Command="{Binding ClearReminderCommand}" />
                </StackPanel>

                <!-- text note -->
                <TextBox Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"
                         VerticalContentAlignment="Top" Padding="10"
                         Text="{Binding Selected.Body, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />

                <!-- checklist note -->
                <DockPanel Grid.Row="3" Visibility="{Binding ShowChecklist, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{Binding [notes_add_item]}" Command="{Binding AddItemCommand}" />
                        <TextBox Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddItemCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Selected.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,3" FontFamily="Segoe MDL2 Assets" Content="&#xE711;"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- footer -->
                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{Binding [notes_delete]}" Command="{Binding DeleteCommand}" />
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{Binding [notes_export_md]}" Command="{Binding ExportMarkdownCommand}" />
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{Binding [notes_export_txt]}" Command="{Binding ExportTextCommand}" />
                    <StackPanel>
                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource Style.Muted}" FontSize="12" />
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Accent}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
