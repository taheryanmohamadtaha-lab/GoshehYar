<Window x:Class="GoshehYar.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoshehYar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FlowDirection="LeftToRight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Left="0" Top="0" Width="60" Height="200">

    <!-- Root clips the card so only the visible part of the panel shows while it slides in and out. -->
    <Grid x:Name="Root" ClipToBounds="True">

        <Border x:Name="Card"
                Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="56" Height="200">

            <ItemsControl ItemsSource="{Binding Items}"
                          Margin="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Style.ToolButton}"
                                Command="{Binding Command}"
                                ToolTip="{Binding ToolTip}"
                                Width="{Binding DataContext.ButtonSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Height="{Binding DataContext.ButtonSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Margin="{Binding DataContext.ItemMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Grid>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{Binding DataContext.IconFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding LiveText}"
                                           FontSize="{Binding DataContext.LiveFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Thin accent handle: this is what stays on the screen edge while the panel is hidden. -->
        <Border x:Name="HandleBar"
                Background="{DynamicResource Brush.Accent}"
                CornerRadius="3"
                Opacity="0"
                IsHitTestVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="6" />
    </Grid>
</Window>
