<Window x:Class="GoshehYar.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,4,0,0" Padding="18">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="120"
                       Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock x:Name="TimeText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />

            <TextBlock x:Name="SnoozeLabel" Margin="0,14,0,4" />
            <WrapPanel x:Name="SnoozePanel" />

            <UniformGrid Rows="1" Margin="0,14,0,0">
                <Button x:Name="OpenButton" Margin="0,0,4,0" Click="OnOpen" />
                <Button x:Name="DismissButton" Margin="4,0,0,0" IsDefault="True" Click="OnDismiss" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
