<Window x:Class="GoshehYar.App.Views.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_tasks]}"
        Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding [task_add]}" Command="{Binding AddCommand}" Margin="6,0,0,0" Padding="14,4" />
                <TextBox x:Name="NewBox" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewBox_KeyDown"
                         ToolTip="{Binding [task_add_hint]}" />
            </DockPanel>

            <ComboBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Filters}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Filter}" />

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding [task_search]}" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Margin="4,0,0,0" ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding CategoryFilter}" />
            </Grid>

            <ListBox Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4">
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                                      IsChecked="{Binding Done, Mode=OneWay}" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}" />
                            <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE823;" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                       Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Meta}" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMeta}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Overdue}" Value="True">
                                                    <Setter Property="Foreground" Value="OrangeRed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="{Binding [task_empty_list]}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Muted}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{Binding [task_clear_done]}" Command="{Binding ClearDoneCommand}" />
                <TextBlock Text="{Binding CountText, Mode=OneWay}" Style="{StaticResource Style.Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <!-- editor -->
        <Grid Grid.Column="2">
            <TextBlock Text="{Binding [task_empty_hint]}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Visibility>
                    <Binding Path="NoSelection" Converter="{StaticResource BoolToVisibility}" />
                </TextBlock.Visibility>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding [task_title]}" Style="{StaticResource Style.Muted}" />
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding [task_note]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="{Binding [task_due]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding [task_clear_date]}" Command="{Binding ClearDateCommand}" Margin="6,0,0,0" />
                        <DatePicker SelectedDate="{Binding EditDate}" />
                    </DockPanel>
                    <CheckBox Content="{Binding [task_has_time]}" IsChecked="{Binding EditHasTime}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,6,0,0" IsEnabled="{Binding EditHasTime}">
                        <ComboBox Width="64" ItemsSource="{Binding Hours}" SelectedItem="{Binding EditHour}" ItemStringFormat="00" />
                        <TextBlock Text=" : " VerticalAlignment="Center" />
                        <ComboBox Width="64" ItemsSource="{Binding Minutes}" SelectedItem="{Binding EditMinute}" ItemStringFormat="00" />
                    </StackPanel>

                    <TextBlock Text="{Binding [task_priority]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <ComboBox ItemsSource="{Binding Priorities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditPriority}" />

                    <TextBlock Text="{Binding [task_category]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding [task_reminder]}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <ComboBox ItemsSource="{Binding ReminderChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditReminder}"
                              IsEnabled="{Binding ReminderPossible}" />
                    <TextBlock Text="{Binding ReminderHint, Mode=OneWay}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding [btn_save]}" Click="SaveClick" Padding="14,4" Margin="0,0,8,0" />
                        <Button Content="{Binding [task_delete]}" Command="{Binding DeleteCommand}" Padding="14,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding DoneInfo, Mode=OneWay}" Style="{StaticResource Style.Muted}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding MetaText, Mode=OneWay}" Style="{StaticResource Style.Muted}" />
                    <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource Style.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
