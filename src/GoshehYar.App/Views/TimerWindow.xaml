<Window x:Class="GoshehYar.App.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_timer]}"
        Width="440" Height="600" MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding [tmr_running_hint]}" Style="{StaticResource Style.Muted}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />
        <TabControl>

            <!-- countdown -->
            <TabItem Header="{Binding [tmr_tab_countdown]}">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding CdDisplay}" FontSize="54" FontWeight="SemiBold" HorizontalAlignment="Center"
                               FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding CdStateText}" HorizontalAlignment="Center" Style="{StaticResource Style.Muted}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding CdProgress, Mode=OneWay}" Height="8" Margin="0,12,0,12"
                                 Foreground="{DynamicResource Brush.Accent}" />

                    <Grid IsEnabled="{Binding CdCanStart}" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="3">
                            <TextBlock Text="{Binding [tmr_hours]}" Style="{StaticResource Style.Muted}" />
                            <ComboBox ItemsSource="{Binding HourChoices}" SelectedItem="{Binding Hours}" ItemStringFormat="00" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3">
                            <TextBlock Text="{Binding [tmr_minutes]}" Style="{StaticResource Style.Muted}" />
                            <ComboBox ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding Minutes}" ItemStringFormat="00" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="3">
                            <TextBlock Text="{Binding [tmr_seconds]}" Style="{StaticResource Style.Muted}" />
                            <ComboBox ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding Seconds}" ItemStringFormat="00" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding [tmr_presets]}" Style="{StaticResource Style.Muted}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Presets}" IsEnabled="{Binding CdCanStart}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Padding="10,5"
                                        Content="{Binding Label}"
                                        Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Minutes}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Rows="1" Margin="0,12,0,0">
                        <Button Content="{Binding [tmr_start]}" Command="{Binding StartCountdownCommand}" Margin="0,0,4,0" Padding="0,8"
                                Visibility="{Binding CdCanStart, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding [tmr_pause]}" Command="{Binding PauseCountdownCommand}" Margin="0,0,4,0" Padding="0,8"
                                Visibility="{Binding CdIsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding [tmr_resume]}" Command="{Binding ResumeCountdownCommand}" Margin="0,0,4,0" Padding="0,8"
                                Visibility="{Binding CdIsPaused, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding [tmr_reset]}" Command="{Binding ResetCountdownCommand}" Margin="4,0,0,0" Padding="0,8" />
                    </UniformGrid>
                </StackPanel>
            </TabItem>

            <!-- stopwatch -->
            <TabItem Header="{Binding [tmr_tab_stopwatch]}">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding StopwatchText}" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   FlowDirection="LeftToRight" Margin="0,8,0,12" />
                        <UniformGrid Rows="1">
                            <Button Content="{Binding [tmr_start]}" Command="{Binding StartStopwatchCommand}" Margin="0,0,4,0" Padding="0,8"
                                    Visibility="{Binding SwIsStopped, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding [tmr_pause]}" Command="{Binding PauseStopwatchCommand}" Margin="0,0,4,0" Padding="0,8"
                                    Visibility="{Binding SwIsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding [tmr_lap]}" Command="{Binding LapCommand}" IsEnabled="{Binding SwIsRunning}"
                                    Margin="4,0,4,0" Padding="0,8" />
                            <Button Content="{Binding [tmr_reset]}" Command="{Binding ResetStopwatchCommand}" IsEnabled="{Binding SwCanReset}"
                                    Margin="4,0,0,0" Padding="0,8" />
                        </UniformGrid>
                        <TextBlock Text="{Binding [tmr_laps]}" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock Text="{Binding [tmr_lap_none]}" Style="{StaticResource Style.Muted}"
                                   Visibility="{Binding NoLaps, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Laps}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LapTime}" Margin="12,0" FlowDirection="LeftToRight" />
                                    <TextBlock Grid.Column="2" Text="{Binding Total}" Foreground="{DynamicResource Brush.Muted}"
                                               FlowDirection="LeftToRight" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- pomodoro -->
            <TabItem Header="{Binding [tmr_tab_pomodoro]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding PomodoroPhaseText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding PomodoroDisplay}" FontSize="54" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   FlowDirection="LeftToRight" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PomodoroProgress, Mode=OneWay}" Height="8" Margin="0,8,0,8"
                                     Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding PomodoroCycleText}" HorizontalAlignment="Center" Style="{StaticResource Style.Muted}" />
                        <TextBlock Text="{Binding PomodoroTodayText}" HorizontalAlignment="Center" Margin="0,2,0,10" />

                        <UniformGrid Rows="1">
                            <Button Content="{Binding PomodoroToggleText}" Command="{Binding PomodoroToggleCommand}" Margin="0,0,4,0" Padding="0,8" />
                            <Button Content="{Binding [tmr_skip]}" Command="{Binding PomodoroSkipCommand}" Margin="4,0,4,0" Padding="0,8" />
                            <Button Content="{Binding [tmr_reset]}" Command="{Binding PomodoroResetCommand}" IsEnabled="{Binding PomodoroCanReset}"
                                    Margin="4,0,0,0" Padding="0,8" />
                        </UniformGrid>

                        <Grid Margin="0,14,0,0" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="3">
                                <TextBlock Text="{Binding [tmr_work_minutes]}" Style="{StaticResource Style.Muted}" />
                                <ComboBox ItemsSource="{Binding WorkChoices}" SelectedItem="{Binding WorkMinutes}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3">
                                <TextBlock Text="{Binding [tmr_short_minutes]}" Style="{StaticResource Style.Muted}" />
                                <ComboBox ItemsSource="{Binding ShortChoices}" SelectedItem="{Binding ShortMinutes}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="3,8,3,3">
                                <TextBlock Text="{Binding [tmr_long_minutes]}" Style="{StaticResource Style.Muted}" />
                                <ComboBox ItemsSource="{Binding LongChoices}" SelectedItem="{Binding LongMinutes}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="3,8,3,3">
                                <TextBlock Text="{Binding [tmr_sessions_before_long]}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" />
                                <ComboBox ItemsSource="{Binding SessionChoices}" SelectedItem="{Binding SessionsBeforeLong}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="{Binding [tmr_auto_next]}" IsChecked="{Binding AutoStartNext}" Margin="0,12,0,0" />
                        <CheckBox Content="{Binding [tmr_sound]}" IsChecked="{Binding SoundEnabled}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
