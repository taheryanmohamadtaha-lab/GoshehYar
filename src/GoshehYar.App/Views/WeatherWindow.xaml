<Window x:Class="GoshehYar.App.Views.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [mod_weather]}"
        Width="420" Height="640" MinWidth="360" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <!-- city search -->
            <StackPanel Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding [wx_no_location]}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding ShowNoLocation, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                             ToolTip="{Binding [wx_city_hint]}" KeyDown="QueryBox_KeyDown" />
                    <Button Grid.Column="1" Content="{Binding [wx_search]}" Command="{Binding SearchCommand}"
                            Margin="8,0,0,0" Padding="14,6" />
                </Grid>
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                         Margin="0,8,0,0" MaxHeight="220" DisplayMemberPath="Label"
                         Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- current weather -->
            <StackPanel Visibility="{Binding ShowWeather, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding [wx_change_city]}" Command="{Binding ChangeCityCommand}"
                            Padding="10,4" />
                    <TextBlock Text="{Binding CityText}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" FlowDirection="LeftToRight">
                    <TextBlock Text="{Binding Icon}" FontSize="64" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Temperature}" FontSize="56" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Condition}" FontSize="18" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding TodayRange}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Accent}" />

                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [wx_feels]}" Style="{StaticResource Style.Muted}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FeelsLike}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [wx_humidity]}" Style="{StaticResource Style.Muted}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Humidity}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [wx_wind]}" Style="{StaticResource Style.Muted}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Wind}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <TextBlock Text="{Binding [wx_next_days]}" FontWeight="SemiBold" Margin="0,18,0,6" />
                <ItemsControl ItemsSource="{Binding Forecast}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Weekday}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Condition}" Style="{StaticResource Style.Muted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Range}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           FlowDirection="LeftToRight" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox Content="{Binding [wx_fahrenheit]}" IsChecked="{Binding IsFahrenheit}" Margin="0,14,0,0" />
                <Button Content="{Binding [wx_refresh]}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                        Margin="0,10,0,0" Padding="14,5" />
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Style.Muted}" Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding [wx_credit]}" Style="{StaticResource Style.Muted}" FontSize="11" Margin="0,16,0,0"
                       FlowDirection="LeftToRight" />
        </StackPanel>
    </ScrollViewer>
</Window>
